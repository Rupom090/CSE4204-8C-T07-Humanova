APP_NAME=Humanova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=humanova
DB_USERNAME=root
DB_PASSWORD=

# ─── Session ────────────────────────────────────────────────
# Use "redis" if Redis is installed, "database" otherwise
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Queue & Cache ──────────────────────────────────────────
# Use "redis" if Redis is installed, "database" otherwise
QUEUE_CONNECTION=database
CACHE_STORE=database
QUEUE_FAILED_DRIVER=database

# ─── Redis (enable if Redis is installed) ───────────────────
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# ─── Mail ───────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@humanova.ai"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS / Storage ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Sanctum / SPA Auth ────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:8000

# ─── Frontend URL (React/Vite dev server) ───────────────────
FRONTEND_URL=http://localhost:5173

# ─── Google OAuth ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/api/v1/auth/oauth/google/callback"

# ─── AI Provider API Base URLs ──────────────────────────────
OPENAI_API_BASE=https://api.openai.com/v1
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# ─── Python AI Microservice ────────────────────────────────
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=30

# ─── PDF Export ─────────────────────────────────────────────
PDF_EXPORT_TIMEOUT=120
PDF_MAX_FILE_SIZE=20

# ─── Analytics ──────────────────────────────────────────────
ANALYTICS_CACHE_TTL=3600
ANALYTICS_REFRESH_INTERVAL=900

# ─── Security ──────────────────────────────────────────────
FORCE_HTTPS=false
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT=60
AUTH_RATE_LIMIT=5
BLOCK_PRIVATE_IPS=true
MAX_REDIRECTS=3

# ─── Feature Flags ─────────────────────────────────────────
ENABLE_COMMUNITY_REPORTS=true
ENABLE_PROVIDER_COMPARISON=true

# ─── Monitoring ─────────────────────────────────────────────
SENTRY_DSN=
MONITORING_ENABLED=false

# ─── Queue Worker ───────────────────────────────────────────
QUEUE_WORKER_TIMEOUT=120
QUEUE_RETRY_AFTER=90

VITE_APP_NAME="${APP_NAME}"
